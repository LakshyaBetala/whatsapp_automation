{
  "name": "asva-desktop",
  "version": "1.8.6",
  "description": "ASVA - reads Tally, sends bills and reminders on the shop's own WhatsApp.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.asva.shop",
    "productName": "ASVA",
    "copyright": "ASVA",
    "directories": {
      "output": "../dist_installer",
      "buildResources": "."
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://app.tryasva.com/updates"
      }
    ],
    "releaseInfo": {
      "releaseNotes": "New Payments tab: see who says they have paid, then confirm the amount and account to post the receipt straight into Tally.\nPhone app now shows each party's promise-to-pay and recent replies, with a tap-to-call button.\nThe who-to-chase list has search, sort and pages.\nReminders can lead with a chosen UPI or your bank account, and always carry your bank details so customers stop asking.\nClearer language handling, a clickable renew link, and a what's-new note after every update."
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../wa_service",
        "to": "wa_service",
        "filter": ["**/*", "!node_modules/.cache/**", "!.baileys_auth/**"]
      },
      {
        "from": "../dist_agent",
        "to": "agent",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.ico",
      "artifactName": "ASVA-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "ASVA",
      "deleteAppDataOnUninstall": false
    }
  }
}

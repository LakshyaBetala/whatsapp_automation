{
  "name": "asva-desktop",
  "version": "2.2.9",
  "description": "ASVA - reads Tally, sends bills and reminders on the shop's own WhatsApp.",
  "author": "Almmatix",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.asva.shop",
    "productName": "ASVA",
    "copyright": "Copyright (c) 2026 Almmatix",
    "directories": {
      "output": "../dist_installer",
      "buildResources": "."
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://app.tryasva.com/updates"
      }
    ],
    "releaseInfo": {
      "releaseNotes": "ASVA 2.2.9.\n\nWhatsApp now lives on ASVA's server instead of this computer. Bills and reminders keep going out when the shop PC is off, asleep or restarting.\n\nOne QR, not two. Scan it once in ASVA and you are connected.\n\nA reminder can no longer go out twice if the network hiccups mid-send."
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../wa_service",
        "to": "wa_service",
        "filter": [
          "**/*",
          "!node_modules/.cache/**",
          "!.baileys_auth/**"
        ]
      },
      {
        "from": "../dist_agent",
        "to": "agent",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "publisherName": "Almmatix",
      "artifactName": "ASVA-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "ASVA",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  }
}

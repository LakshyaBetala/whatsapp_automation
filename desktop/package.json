{
  "name": "asva-desktop",
  "version": "1.8.7",
  "description": "ASVA - reads Tally, sends bills and reminders on the shop's own WhatsApp.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.asva.shop",
    "productName": "ASVA",
    "copyright": "ASVA",
    "directories": {
      "output": "../dist_installer",
      "buildResources": "."
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://app.tryasva.com/updates"
      }
    ],
    "releaseInfo": {
      "releaseNotes": "New Payments tab: confirm a customer's payment and post it straight into Tally in one tap (no more double entries).\nWhen a name matches several parties, reply with a number to pick the right one; mistyped commands get a suggestion.\nRedesigned phone app: cleaner, with a Chase-today list and one-tap call.\nTake a guided in-app tour anytime from the ? Tour button.\nClearer English lead replies and steadier reminders."
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../wa_service",
        "to": "wa_service",
        "filter": ["**/*", "!node_modules/.cache/**", "!.baileys_auth/**"]
      },
      {
        "from": "../dist_agent",
        "to": "agent",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.ico",
      "artifactName": "ASVA-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "ASVA",
      "deleteAppDataOnUninstall": false
    }
  }
}

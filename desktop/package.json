{
  "name": "asva-desktop",
  "version": "2.2.1",
  "description": "ASVA - reads Tally, sends bills and reminders on the shop's own WhatsApp.",
  "author": "Almmatix",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.asva.shop",
    "productName": "ASVA",
    "copyright": "Copyright (c) 2026 Almmatix",
    "directories": {
      "output": "../dist_installer",
      "buildResources": "."
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://app.tryasva.com/updates"
      }
    ],
    "releaseInfo": {
      "releaseNotes": "ASVA 2.2.1.\n\nBack to the familiar green ASVA, with the simpler layout kept: five places on the left (Today, Parties, Payments, Reminders, Settings), with WhatsApp and Reports at the bottom.\n\nFixes: the Today screen was stuck on loading and the Add-a-payment button on Payments did nothing. Both work again.\n\nBills on a party page now make sense: one row per bill, no bill shown twice, nothing marked paid while it still shows a balance, and bills already cleared in Tally are tucked under \"Settled bills\"."
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../wa_service",
        "to": "wa_service",
        "filter": [
          "**/*",
          "!node_modules/.cache/**",
          "!.baileys_auth/**"
        ]
      },
      {
        "from": "../dist_agent",
        "to": "agent",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "publisherName": "Almmatix",
      "artifactName": "ASVA-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "ASVA",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  }
}

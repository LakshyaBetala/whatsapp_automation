{
  "name": "asva-desktop",
  "version": "2.2.3",
  "description": "ASVA - reads Tally, sends bills and reminders on the shop's own WhatsApp.",
  "author": "Almmatix",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.asva.shop",
    "productName": "ASVA",
    "copyright": "Copyright (c) 2026 Almmatix",
    "directories": {
      "output": "../dist_installer",
      "buildResources": "."
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://app.tryasva.com/updates"
      }
    ],
    "releaseInfo": {
      "releaseNotes": "ASVA 2.2.3.\n\nUpdates install cleanly: closing ASVA now stops the Tally reader every time, including one-off runs, and an update waits until everything has really stopped before it installs. Before this, a reader left running could block the update silently.\n\nThe fold control moved next to the ASVA mark, where the menu is. Click the mark or the arrow, or press Ctrl+B.\n\nMidnight and Blue are consistent now: cards, tables, chips, inputs and status colours all follow the theme instead of staying half light."
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../wa_service",
        "to": "wa_service",
        "filter": [
          "**/*",
          "!node_modules/.cache/**",
          "!.baileys_auth/**"
        ]
      },
      {
        "from": "../dist_agent",
        "to": "agent",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "publisherName": "Almmatix",
      "artifactName": "ASVA-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "ASVA",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  }
}

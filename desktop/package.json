{
  "name": "asva-desktop",
  "version": "2.2.8",
  "description": "ASVA - reads Tally, sends bills and reminders on the shop's own WhatsApp.",
  "author": "Almmatix",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.asva.shop",
    "productName": "ASVA",
    "copyright": "Copyright (c) 2026 Almmatix",
    "directories": {
      "output": "../dist_installer",
      "buildResources": "."
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://app.tryasva.com/updates"
      }
    ],
    "releaseInfo": {
      "releaseNotes": "ASVA 2.2.8.\n\nPreview now shows the message your customers actually receive. It had been showing an older version of the reminder, with the old payment link, so changing a batch looked like it changed nothing.\n\nIf an update ever fails, ASVA now says why instead of only saying it failed, and writes it down so it can be fixed."
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../wa_service",
        "to": "wa_service",
        "filter": [
          "**/*",
          "!node_modules/.cache/**",
          "!.baileys_auth/**"
        ]
      },
      {
        "from": "../dist_agent",
        "to": "agent",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "publisherName": "Almmatix",
      "artifactName": "ASVA-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "ASVA",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  }
}

{
  "name": "asva-desktop",
  "version": "1.8.5",
  "description": "ASVA - reads Tally, sends bills and reminders on the shop's own WhatsApp.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.asva.shop",
    "productName": "ASVA",
    "copyright": "ASVA",
    "directories": {
      "output": "../dist_installer",
      "buildResources": "."
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://app.tryasva.com/updates"
      }
    ],
    "releaseInfo": {
      "releaseNotes": "Speaks your language: ASVA now replies in English or Hinglish, in the app and on WhatsApp.\nFinds the right party even from a short name or a small typo, and asks when it is unsure.\nRECOVERED: see how much money came back this month.\nPhone app: scan a QR from the app to see your dues on your phone (view only).\nSteadier reminders, a clearer health check, and one-tap Check for updates."
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../wa_service",
        "to": "wa_service",
        "filter": ["**/*", "!node_modules/.cache/**", "!.baileys_auth/**"]
      },
      {
        "from": "../dist_agent",
        "to": "agent",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.ico",
      "artifactName": "ASVA-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "ASVA",
      "deleteAppDataOnUninstall": false
    }
  }
}

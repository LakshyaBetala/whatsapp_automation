{
  "name": "asva-desktop",
  "version": "2.2.0",
  "description": "ASVA - reads Tally, sends bills and reminders on the shop's own WhatsApp.",
  "author": "Almmatix",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.asva.shop",
    "productName": "ASVA",
    "copyright": "Copyright (c) 2026 Almmatix",
    "directories": {
      "output": "../dist_installer",
      "buildResources": "."
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://app.tryasva.com/updates"
      }
    ],
    "releaseInfo": {
      "releaseNotes": "ASVA 2.2.0.\n\nA calmer, simpler ASVA. Five places on the left: Today, Parties, Payments, Reminders and Settings. WhatsApp and Reports sit at the bottom of the left bar.\n\nOne language menu at the top. ASVA is in English unless you pick Hinglish or Hindi, and customer messages stay in English unless you set a batch to Hinglish.\n\nTour, Phone app, update check and dark mode are under More, so the top bar stays clear.\n\nNew look: clean paper-and-blue screens, easier to read. Nothing about your data or reminders changes."
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../wa_service",
        "to": "wa_service",
        "filter": [
          "**/*",
          "!node_modules/.cache/**",
          "!.baileys_auth/**"
        ]
      },
      {
        "from": "../dist_agent",
        "to": "agent",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "publisherName": "Almmatix",
      "artifactName": "ASVA-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "ASVA",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  }
}

# ASVA remote-deploy config. Copy to  deploy/remote.env  and fill in.
# deploy/remote.env is git-ignored (it names your private host). Never commit it.
#
# I3_HOST is the Tailscale MACHINE NAME of the i3 (from `tailscale status`),
# e.g. asva-i3  OR its Tailscale IP like 100.x.y.z. Tailscale makes this
# reachable from anywhere - no port-forwarding, no public IP.
I3_HOST=asva-i3
I3_USER=laksh
# Where the ASVA server code lives on the i3 (the repo root, holds .venv + .env).
I3_DIR=/home/laksh/asva
# Optional: path to a private SSH key if you use one. Leave blank to use the
# default agent / ~/.ssh/id_ed25519.
SSH_KEY=
